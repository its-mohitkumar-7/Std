module Std::Parse {
    func ParseInt(str: char8[]) -> int {
        if str.length == 0 {
            return 0;
        }
        
        var result: int = 0;
        var negative = false;
        var start: uint = 0u;
        
        if str.data[0] == c8'-' {
            negative = true;
            start = 1u;
        } else if str.data[0] == c8'+' {
            start = 1u;
        }
        
        var i = start;
        while i < str.length {
            let ch = str.data[i];
            if ch >= c8'0' && ch <= c8'9' {
                result = result * 10 + (ch as int - 48);
            }
            i += 1u;
        }
        
        return negative ? -result : result;
    }

    func ParseFloat(str: char8[]) -> float {
        if str.length == 0 {
            return 0.0;
        }

        var sign: bool = false;
        var IntegerPart: uint = 0u;
        var DecimalPoint: bool8 = false;
        var FractionalPart: float64 = 0.0f64;

        var ExponentVariable: bool8 = false;
        var ExponentSign: bool8 = false;
        var ExponentValue: uint = 0u;

        var start: uint = 0u;

        if str.data[0] == c8'-' {
            sign = true;
            start = 1u;
        }

        var divisor: float64 = 10.0f64;

        var i = start;
        while i < str.length {
            let ch = str.data[i];

            if ch >= c8'0' && ch <= c8'9' && !DecimalPoint && !ExponentVariable {
                IntegerPart = IntegerPart * 10u + ((ch as uint) - 48u);
            }

            if ch == c8'.' && !ExponentVariable {
                DecimalPoint = true;
            }

            if ch >= c8'0' && ch <= c8'9' && DecimalPoint && !ExponentVariable {
                var digit = ((ch as uint) - 48u) as float64;
                FractionalPart += digit / divisor;
                divisor *= 10.0f64;
            }

            if ch == c8'e' || ch == c8'E' {
                ExponentVariable = true;
            }

            if ExponentVariable && ch == c8'-' {
                ExponentSign = true;
            }

            if ExponentVariable && ch >= c8'0' && ch <= c8'9' {
                ExponentValue = ExponentValue * 10u + ((ch as uint) - 48u);
            }

            i += 1u;
        }

        var result: float64 = IntegerPart as float64 + FractionalPart;

        if ExponentValue > 0 {
            var power: float64 = 1.0f64;

            var j: uint = 0u;
            while j < ExponentValue {
                power *= 10.0f64;
                j += 1u;
            }

            if ExponentSign {
                result /= power;
            } else {
                result *= power;
            }
        }

        return sign ? -result : result;
    }

    func EqIgnoreCase(a: int8, lower: int8, upper: int8) -> bool8 {
        if (a == lower) {
            return true;
        }

        if (a == upper) {
            return true;
        }

        return false;
    }

    func ParseBool(str: char8[]) -> bool8 {
        var buf: char8[5];
        var len: uint = 0;

        for ch in str {
            if ((ch as int8) <= 32) {
                continue;
            }

            if (len >= 5) {
                return false;
            }

            buf[len] = ch;
            len += 1;
        }

        if (len == 1) {
            let a = buf[0] as int8;

            if (a == 49) {
                return true;
            }

            if (a == 48) {
                return false;
            }

            if (EqIgnoreCase(a, 116, 84)) {
                return true;
            }

            if (EqIgnoreCase(a, 102, 70)) {
                return false;
            }

            if (EqIgnoreCase(a, 121, 89)) {
                return true;
            }

            if (EqIgnoreCase(a, 110, 78)) {
                return false;
            }

            return false;
        }

        if (len == 2) {
            let a = buf[0] as int8;
            let b = buf[1] as int8;

            if (EqIgnoreCase(a, 111, 79)) {
                if (EqIgnoreCase(b, 110, 78)) {
                    return true;
                }
            }

            if (EqIgnoreCase(a, 110, 78)) {
                if (EqIgnoreCase(b, 111, 79)) {
                    return false;
                }
            }

            return false;
        }

        if (len == 3) {
            let a = buf[0] as int8;
            let b = buf[1] as int8;
            let c = buf[2] as int8;

            if (EqIgnoreCase(a, 121, 89)) {
                if (EqIgnoreCase(b, 101, 69)) {
                    if (EqIgnoreCase(c, 115, 83)) {
                        return true;
                    }
                }
            }

            if (EqIgnoreCase(a, 111, 79)) {
                if (EqIgnoreCase(b, 102, 70)) {
                    if (EqIgnoreCase(c, 102, 70)) {
                        return false;
                    }
                }
            }

            return false;
        }

        if (len == 4) {
            let a = buf[0] as int8;
            let b = buf[1] as int8;
            let c = buf[2] as int8;
            let d = buf[3] as int8;

            if (EqIgnoreCase(a, 116, 84)) {
                if (EqIgnoreCase(b, 114, 82)) {
                    if (EqIgnoreCase(c, 117, 85)) {
                        if (EqIgnoreCase(d, 101, 69)) {
                            return true;
                        }
                    }
                }
            }

            return false;
        }

        if (len == 5) {
            let a = buf[0] as int8;
            let b = buf[1] as int8;
            let c = buf[2] as int8;
            let d = buf[3] as int8;
            let e = buf[4] as int8;

            if (EqIgnoreCase(a, 102, 70)) {
                if (EqIgnoreCase(b, 97, 65)) {
                    if (EqIgnoreCase(c, 108, 76)) {
                        if (EqIgnoreCase(d, 115, 83)) {
                            if (EqIgnoreCase(e, 101, 69)) {
                                return false;
                            }
                        }
                    }
                }
            }

            return false;
        }

        return false;
    }

    func IsInt(num: char8[]) -> bool8 {
        var started: bool8 = false;
        var has_digits: bool8 = false;

        for ch in num {
            if (ch as int8 <= 32) {
                continue;
            }

            if (!started) {
                started = true;
                if (ch == '-' || ch == '+') {
                    continue;
                }
            }

            if (ch < '0' || ch > '9') {
                return false;
            }
            has_digits = true;
        }

        return has_digits;
    }
}