module Std::Math {
    func Pi() -> float64 { return 3.14159265358979323846; }
    func E() -> float64 { return 2.71828182845904523536; }
    func Tau() -> float64 { return 6.28318530717958647692; }
    func PiOver2() -> float64 { return 1.57079632679489661923; }
    func PiOver4() -> float64 { return 0.78539816339744830962; }
    func Sqrt2() -> float64 { return 1.41421356237309504880; }
    func Sqrt3() -> float64 { return 1.73205080756887729352; }
    func Ln2() -> float64 { return 0.69314718055994530942; }
    func Ln10() -> float64 { return 2.30258509299404568402; }
    func Log2E() -> float64 { return 1.44269504088896340736; }
    func Log10E() -> float64 { return 0.43429448190325182765; }
    func Phi() -> float64 { return 1.61803398874989484820; }
    func InvPi() -> float64 { return 0.31830988618379067154; }
    func InvSqrt2() -> float64 { return 0.70710678118654752440; }
    func Sqrt2Pi() -> float64 { return 2.50662827463100050242; }

    func Pi32() -> float32 { return 3.14159265358979323846f32; }
    func E32() -> float32 { return 2.71828182845904523536f32; }
    func Tau32() -> float32 { return 6.28318530717958647692f32; }
    func PiOver2_32() -> float32 { return 1.57079632679489661923f32; }
    func PiOver4_32() -> float32 { return 0.78539816339744830962f32; }
    func Sqrt2_32() -> float32 { return 1.41421356237309504880f32; }
    func Sqrt3_32() -> float32 { return 1.73205080756887729352f32; }
    func Ln2_32() -> float32 { return 0.69314718055994530942f32; }
    func Ln10_32() -> float32 { return 2.30258509299404568402f32; }
    func Phi_32() -> float32 { return 1.61803398874989484820f32; }

    func Add(x: int, y: int) -> int
    {
        return x + y;
    }

    func sin64(x: float64) -> float64
    {
        if x != x { return x; }
        if x == Inf64() { return Nan64(); }
        if x == NegInf64() { return Nan64(); }
        var r = x;
        var neg = false;
        if r < 0.0 {
            neg = true;
            r = -r;
        }

        if r >= Tau() {
            if r / Tau() >= 9.0e18 { return 0.0; }
            let n = (r / Tau()) as int64;
            r = r - (n as float64) * Tau();
        }

        if r >= Pi() {
            neg = !neg;
            r = r - Pi();
        }
        if r > PiOver2() {
            r = Pi() - r;
        }

        var useCos = false;
        if r > PiOver4() {
            useCos = true;
            r = PiOver2() - r;
        }

        let r2 = r * r;

        let SinCoeff3 = -1.66666666666666666667e-01;  // -1/3!
        let SinCoeff5 =  8.33333333333333333333e-03;  //  1/5!
        let SinCoeff7 = -1.98412698412698412698e-04;  // -1/7!
        let SinCoeff9 =  2.75573192239858906526e-06;  //  1/9!
        let SinCoeff11 = -2.50521083854417187751e-08; // -1/11!

        let CosCoeff2 = -5.0e-01;                     // -1/2!
        let CosCoeff4 =  4.16666666666666666667e-02;  //  1/4!
        let CosCoeff6 = -1.38888888888888888889e-03;  // -1/6!
        let CosCoeff8 =  2.48015873015873015873e-05;  //  1/8!
        let CosCoeff10 = -2.75573192239858906526e-07; // -1/10!

        var result: float64;
        if useCos == false {
            result = r + r * r2 * (SinCoeff3 + r2 * (SinCoeff5 + r2 * (SinCoeff7 + r2 * (SinCoeff9 + r2 * SinCoeff11))));
        } else {
            result = 1.0 + r2 * (CosCoeff2 + r2 * (CosCoeff4 + r2 * (CosCoeff6 + r2 * (CosCoeff8 + r2 * CosCoeff10))));
        }

        if neg {
            result = -result;
        }
        return result;
    }

    func cos64(x: float64) -> float64
    {
        if x != x { return x; }
        if x == Inf64() { return Nan64(); }
        if x == NegInf64() { return Nan64(); }
        var r = x;
        if r < 0.0 { r = -r; }

        if r >= Tau() {
            if r / Tau() >= 9.0e18 { return 0.0; }
            let n = (r / Tau()) as int64;
            r = r - (n as float64) * Tau();
        }

        var neg = false;
        if r >= Pi() {
            neg = !neg;
            r = r - Pi();
        }
        if r > PiOver2() {
            neg = !neg;
            r = Pi() - r;
        }

        let r2 = r * r;

        let CosCoeff2 = -5.0e-01;
        let CosCoeff4 =  4.16666666666666666667e-02;
        let CosCoeff6 = -1.38888888888888888889e-03;
        let CosCoeff8 =  2.48015873015873015873e-05;
        let CosCoeff10 = -2.75573192239858906526e-07;

        let SinCoeff3 = -1.66666666666666666667e-01;
        let SinCoeff5 =  8.33333333333333333333e-03;
        let SinCoeff7 = -1.98412698412698412698e-04;
        let SinCoeff9 =  2.75573192239858906526e-06;
        let SinCoeff11 = -2.50521083854417187751e-08;

        var result: float64;
        if r > PiOver4() {
            var t = PiOver2() - r;
            let t2 = t * t;
            result = t + t * t2 * (SinCoeff3 + t2 * (SinCoeff5 + t2 * (SinCoeff7 + t2 * (SinCoeff9 + t2 * SinCoeff11))));
        } else {
            result = 1.0 + r2 * (CosCoeff2 + r2 * (CosCoeff4 + r2 * (CosCoeff6 + r2 * (CosCoeff8 + r2 * CosCoeff10))));
        }

        if neg {
            result = -result;
        }
        return result;
    }

    func Nan64() -> float64
    {
        var zero = 0.0;
        return zero / zero;
    }

    func Inf64() -> float64
    {
        return 1.0 / 0.0;
    }

    func NegInf64() -> float64
    {
        return -1.0 / 0.0;
    }

    func FloatBits64(x: float64) -> uint64
    {
        return 0u64;
    }

    func FloatFromBits64(bits: uint64) -> float64
    {
        return 0.0;
    }

    func FloatBits32(x: float32) -> uint32
    {
        return 0u32;
    }

    func FloatFromBits32(bits: uint32) -> float32
    {
        return 0.0f32;
    }

    func Sin(x: float64) -> float64
    {
        return sin64(x);
    }

    func Cos(x: float64) -> float64
    {
        return cos64(x);
    }

    func Tan(x: float64) -> float64
    {
        return sin64(x) / cos64(x);
    }

    func Sin32(x: float32) -> float32
    {
        return sin64(x as float64) as float32;
    }

    func Cos32(x: float32) -> float32
    {
        return cos64(x as float64) as float32;
    }

    func Tan32(x: float32) -> float32
    {
        let s = sin64(x as float64);
        let c = cos64(x as float64);
        return (s / c) as float32;
    }

    func Sqrt(x: float64) -> float64
    {
        if x != x { return x; }
        if x < 0.0 { return Nan64(); }
        if x == 0.0 { return x; }
        if x == Inf64() { return x; }
        var guess = 1.0;
        var y = x;
        while y >= 4.0 {
            y *= 0.25;
            guess *= 2.0;
        }
        while y < 1.0 {
            y *= 4.0;
            guess *= 0.5;
        }
        var i: uint = 0u;
        while i < 8u {
            guess = 0.5 * (guess + x / guess);
            i += 1u;
        }
        return guess;
    }

    func ln64(x: float64) -> float64
    {
        if x != x { return x; }
        if x < 0.0 { return Nan64(); }
        if x == 0.0 { return -Inf64(); }
        if x == Inf64() { return x; }
        if x == 1.0 { return 0.0; }
        var k: int = 0;
        var r = x;
        while r >= 2.0 {
            r /= 2.0;
            k += 1;
        }
        while r < 1.0 {
            if r < 2.2250738585072014e-308 {
                r *= 1.3407807929942597e154;
                k -= 512;
            } else {
                r *= 2.0;
                k -= 1;
            }
        }
        let z = (r - 1.0) / (r + 1.0);
        let z2 = z * z;
        var sum = z;
        var term = z;
        var n: uint = 1u;
        while n < 18u {
            term *= z2;
            sum += term / ((2u * n + 1u) as float64);
            n += 1u;
        }
        return (k as float64) * Ln2() + 2.0 * sum;
    }

    func exp2i(k: int) -> float64
    {
        var e = k;
        var r = 1.0;
        var p = 2.0;
        if e < 0 {
            p = 0.5;
            e = -e;
        }
        while e > 0 {
            if (e & 1) != 0 {
                r *= p;
            }
            e >>= 1;
            if e > 0 {
                p *= p;
            }
        }
        return r;
    }

    func exp64(x: float64) -> float64
    {
        if x != x { return x; }
        if x == Inf64() { return x; }
        if x == NegInf64() { return 0.0; }
        if x > 710.0 { return Inf64(); }
        if x < -750.0 { return 0.0; }
        let k = Round(x / Ln2()) as int;
        if k > 1023 { return Inf64(); }
        if k < -1074 { return 0.0; }
        var r = x - (k as float64) * Ln2();
        var sum = 1.0;
        var term = 1.0;
        var n: uint = 1u;
        while n < 18u {
            term *= r / (n as float64);
            sum += term;
            n += 1u;
        }
        return sum * exp2i(k);
    }

    func Pow(x: float64, y: float64) -> float64
    {
        if y == 0.0 { return 1.0; }
        if x != x { return x; }
        if y != y { return y; }
        if x == 1.0 { return 1.0; }
        if y == 1.0 { return x; }
        if x == 0.0 {
            if 1.0 / x < 0.0 {
                if y > 9.223372036854775808e18 || y < -9.223372036854775808e18 {
                    if y < 0.0 { return Inf64(); }
                    return 0.0;
                }
                if y == (y as int64) as float64 && ((y as int64) & 1i64) != 0i64 {
                    if y < 0.0 { return -Inf64(); }
                    return -0.0;
                }
            }
            if y < 0.0 { return Inf64(); }
            return 0.0;
        }
        if x == Inf64() {
            if y < 0.0 { return 0.0; }
            return Inf64();
        }
        if x == NegInf64() {
            if y < 0.0 { return 0.0; }
            if y > 0.0 {
                if y > 9.223372036854775808e18 || y < -9.223372036854775808e18 {
                    return Inf64();
                }
                if y == (y as int64) as float64 && ((y as int64) & 1i64) != 0i64 {
                    return -Inf64();
                }
                return Inf64();
            }
            return 0.0;
        }
        if x < 0.0 {
            if y > 9.223372036854775808e18 || y < -9.223372036854775808e18 {
                return Nan64();
            }
            let yi = y as int64;
            if y == yi as float64 {
                let abs = Pow(-x, y);
                if (yi & 1i64) != 0i64 {
                    return -abs;
                }
                return abs;
            }
            return Nan64();
        }
        return exp64(y * ln64(x));
    }

    func Exp(x: float64) -> float64
    {
        return exp64(x);
    }

    func Ln(x: float64) -> float64
    {
        return ln64(x);
    }

    func Log2(x: float64) -> float64
    {
        return ln64(x) / Ln2();
    }

    func Log10(x: float64) -> float64
    {
        return ln64(x) / Ln10();
    }

    func Abs64(x: float64) -> float64
    {
        var bits = FloatBits64(x);
        bits = bits & 0x7FFFFFFFFFFFFFFFu64;
        return FloatFromBits64(bits);
    }

    func Abs(x: int) -> int
    {
        if x < 0 { return -x; }
        return x;
    }

    func Min(x: int, y: int) -> int
    {
        if x < y { return x; }
        return y;
    }

    func Max(x: int, y: int) -> int
    {
        if x > y { return x; }
        return y;
    }

    func MinU(x: uint, y: uint) -> uint
    {
        if x < y { return x; }
        return y;
    }

    func MaxU(x: uint, y: uint) -> uint
    {
        if x > y { return x; }
        return y;
    }

    func Min64(x: float64, y: float64) -> float64
    {
        if x < y { return x; }
        return y;
    }

    func Max64(x: float64, y: float64) -> float64
    {
        if x > y { return x; }
        return y;
    }

    func Min32(x: float32, y: float32) -> float32
    {
        if x < y { return x; }
        return y;
    }

    func Max32(x: float32, y: float32) -> float32
    {
        if x > y { return x; }
        return y;
    }

    func Floor(x: float64) -> float64
    {
        if x != x { return x; }
        if x == Inf64() { return x; }
        if x == NegInf64() { return x; }
        if x == 0.0 && 1.0 / x < 0.0 { return -0.0; }
        if Abs64(x) >= 9007199254740992.0 { return x; }
        let t = x as int;
        let f = t as float64;
        if f > x {
            return (t - 1) as float64;
        }
        return f;
    }

    func Ceil(x: float64) -> float64
    {
        if x != x { return x; }
        if x == Inf64() { return x; }
        if x == NegInf64() { return x; }
        if x == 0.0 && 1.0 / x < 0.0 { return -0.0; }
        if Abs64(x) >= 9007199254740992.0 { return x; }
        let t = x as int;
        let f = t as float64;
        if f < x {
            return (t + 1) as float64;
        }
        return f;
    }

    func Round(x: float64) -> float64
    {
        if x != x { return x; }
        if x == Inf64() { return x; }
        if x == NegInf64() { return x; }
        if x == 0.0 && 1.0 / x < 0.0 { return -0.0; }
        if Abs64(x) >= 9007199254740992.0 { return x; }
        let t = x as int;
        let f = t as float64;
        let frac = x - f;
        if frac > 0.5 {
            return (t + 1) as float64;
        }
        if frac < -0.5 {
            return (t - 1) as float64;
        }
        if frac == 0.5 || frac == -0.5 {
            if (t & 1) != 0 {
                if frac > 0.0 { return (t + 1) as float64; }
                return (t - 1) as float64;
            }
        }
        return f;
    }

    func Sqrt32(x: float32) -> float32
    {
        return Sqrt(x as float64) as float32;
    }

    func Pow32(x: float32, y: float32) -> float32
    {
        return Pow(x as float64, y as float64) as float32;
    }

    func Abs32(x: float32) -> float32
    {
        return x < 0.0f32 ? -x : x;
    }

    func Floor32(x: float32) -> float32
    {
        return Floor(x as float64) as float32;
    }

    func Ceil32(x: float32) -> float32
    {
        return Ceil(x as float64) as float32;
    }

    func Round32(x: float32) -> float32
    {
        return Round(x as float64) as float32;
    }
}